{
  "name": "lock-verifier",
  "version": "1.0.0",
  "description": "Streamflow Lock Verifier for Solana token locks",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@streamflow/stream": "^10.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "pg": "^8.18.0",
    "redis": "^5.11.0",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "*.js",
      "!node_modules/**"
    ]
  }
}